# Copy to .env for local runs. In production these are set in Dokploy (Environment tab);
# real values never go in the repo.

# Public hostname Traefik routes to Umami (locally: umami.localhost, covered by the
# *.localhost test certificate in traefik-testing/).
UMAMI_HOST=umami.localhost

# Random string used by Umami to sign sessions. Generate: openssl rand -base64 32
UMAMI_APP_SECRET=change-me-to-a-long-random-string

# Postgres password for the umami user. Generate: openssl rand -base64 24
# Use URL-safe characters only (it is embedded in DATABASE_URL), e.g. openssl rand -hex 24
UMAMI_DB_PWD=change-me

# Traefik certificate resolver. Dokploy's default is letsencrypt; leave empty locally
# (there is no ACME resolver in traefik-testing/).
TRAEFIK_CERT_RESOLVER=
